#include <stdio.h>

int main() {

    // EMPLOYEE SALARY CALCULATOR
    // Declare variables to store salary details
    float basicSalary;
    float housingAllowance;
    float transportAllowance;
    float taxAmount;
    float grossSalary;
    float netSalary;

    // Request the user to enter the basic salary
    printf("Enter basic salary: N$ ");
    if (scanf("%f", &basicSalary) != 1) {
        printf("Invalid input.\n");
        return 1; 
    }

    // Request the user to enter the housing allowance
    printf("Enter housing allowance: N$ ");
    if (scanf("%f", &housingAllowance) != 1) {
        printf("Invalid input.\n");
        return 1; 
    }

    // Request the user to enter the transport allowance
    printf("Enter transport allowance: N$ ");
    if (scanf("%f", &transportAllowance) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Request the user to enter the tax amount
    printf("Enter tax: N$ ");
    if (scanf("%f", &taxAmount) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Compute the gross salary
    grossSalary = basicSalary + housingAllowance + transportAllowance;

    // Compute the net salary
    netSalary = grossSalary - taxAmount;

    // Print the computed salaries
    printf("Gross Salary: N$ %.2f\n", grossSalary);
    printf("Net Salary: N$ %.2f\n", netSalary);

    return 0;
}